  "data": {
    "source": "coinbase_exchange_public",
    "hourly_candles": 336,
    "daily_candles": 120,
    "max_quote_age_seconds": 180
  },
  "costs": {
    "fee_bps": 40.0,
    "slippage_bps_major": 2.0,
    "slippage_bps_alt": 6.0,
    "impact_coeff": 0.5,
    "sensitivity_fee_bps": [
      10.0,
      60.0
    ],
    "slippage_bps_mid": 10.0
  },
  "risk": {
    "max_weight_major": 0.35,
    "max_weight_alt": 0.15,
    "max_gross_exposure": 0.8,
    "max_alt_cluster": 0.4,
    "max_stop_pct": 18.0,
    "min_stop_pct": 5.0,
    "max_risk_per_position_equity_pct": 5.0,
    "max_turnover_24h": 0.25,
    "min_order_usd": 50.0,
    "max_order_pct_of_24h_volume": 0.005,
    "max_spread_bps": 50.0,
    "daily_loss_limit_pct": 8.0,
    "drawdown_halt_pct": 25.0,
    "halt_lockout_days": 14,
    "max_weight_mid": 0.1
  },
  "llm": {
    "provider": "openai_compat",
    "model": "gpt-oss-120b (open weights)",
    "endpoints": [
      {
        "name": "groq",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "key_env": "GROQ_API_KEY",
        "model": "openai/gpt-oss-120b",
        "extra_body": {
          "reasoning_effort": "medium"
        }
      },
      {
        "name": "openrouter",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "key_env": "OPENROUTER_API_KEY",
        "model": "openai/gpt-oss-120b:free",
        "extra_body": {
          "reasoning": {
            "effort": "medium"
          }
        }
      }
    ],
    "temperature": 0,
    "max_tokens": 8000,
    "timeout_seconds": 120,
    "prompt_file": "prompts/trader_system_v1.md",
    "parse_retries": 1,
    "min_seconds_between_calls": 65
  },
  "arms": {
    "ai_large": {
      "kind": "ai",
      "view": "large",
      "constrained": true
    },
    "ai_largemid": {
      "kind": "ai",
      "view": "large_mid",
      "max_mid_candidates": 5,
      "constrained": true
    },
    "btc_hold": {
      "kind": "buy_hold",
      "asset": "BTC-USD",
      "constrained": false
    },
    "eth_hold": {
      "kind": "buy_hold",
      "asset": "ETH-USD",
      "constrained": false
    },
    "ew_basket": {
      "kind": "equal_weight",
      "over": "large",
      "rebalance": "monthly",
      "constrained": false
    },
    "s_trend": {
      "kind": "strategy",
      "strategy": "trend",
      "band": 0.05,
      "constrained": true
    },
    "s_breakout": {
      "kind": "strategy",
      "strategy": "breakout",
      "band": 0.05,
      "constrained": true
    },
    "s_dip": {
      "kind": "strategy",
      "strategy": "dip",
      "band": 0.05,
      "constrained": true
    },
    "s_rotation": {
      "kind": "strategy",
      "strategy": "rotation",
      "band": 0.05,
      "constrained": true
    }
  },
  "evaluation": {
    "ic_horizons_cycles": {
      "24h": 4,
      "72h": 12
    },
    "nw_lag_days": 5,
    "min_cycles_for_decision": 1240,
    "decision_months": [
      12,
      24
    ],
    "scored_ai_arms": [
      "ai_large",
      "ai_largemid"
    ],
    "scored_assets": "large"
  },
  "scanner": {
    "interval_minutes": 5,
    "candle_granularity_s": 300,
    "cycle_grace_minutes": 2,
    "triggers": {
      "exit_below": true,
      "review_above": true,
      "move_1h_pct": 4.0,
      "volume_spike_ratio": 4.0,
      "volume_spike_min_move_pct": 1.5
    },
    "cooldown_minutes": 180,
    "max_event_calls_per_day": 10,
    "min_minutes_between_event_calls": 30,
    "quiet_minutes_before_cycle": 30,
    "heartbeat_minutes": 60,
    "_note": "Per AI arm. Budget: Groq free tier 200k tokens/day and 8k tokens/min; ~5-7k tokens per call; 2 arms x (4 scheduled + 10 events) + retries stays under it. Calls are spaced >= 65 s apart."
  },
  "strategies": {
    "_note": "Textbook defaults, fixed before any test. Not tuned. See crypto_ai/strategies/toolbox.py.",
    "trend": {
